FROM denoland/deno:2.9.5

WORKDIR /app

COPY deno.lock ./
COPY src/ ./src/
COPY supabase/ ./supabase/

RUN deno cache supabase/functions/app-api/index.ts

EXPOSE 9000

ENV PORT=9000 \
    MALLOC_ARENA_MAX=2 \
    DENO_V8_FLAGS="--max-old-space-size=256 --optimize-for-size"

CMD ["run", "-A", "supabase/functions/app-api/index.ts"]
