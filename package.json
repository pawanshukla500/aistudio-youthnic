{
  "name": "ai-studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "validate:catalog-sql": "node scripts/validate-sql-migration.mjs supabase/migrations",
    "test:catalog-workflow": "node scripts/verify-catalog-workflow-v2.mjs && node --check scripts/verify-catalog-workflow-live.mjs && npx --yes deno test supabase/functions/app-api/lib/catalogHandoffCalendar.test.ts supabase/functions/app-api/lib/catalogStageTimeline.test.ts && npx --yes deno check supabase/functions/app-api/index.ts",
    "verify:catalog-workflow": "npm run lint && npm run test:catalog-workflow && node scripts/validate-sql-migration.mjs supabase/migrations/20260824130000_catalog_workflow_v2.sql supabase/migrations/20260824153000_catalog_workflow_v2_hardening.sql && npm run build",
    "verify:catalog-workflow:live": "node scripts/verify-catalog-workflow-live.mjs",
    "preview": "vite preview",
    "firebase:sync-supabase-claims": "node scripts/sync-firebase-supabase-claims.mjs",
    "supabase:verify-firebase": "node scripts/verify-supabase-firebase.mjs",
    "supabase:verify-cutover": "node scripts/verify-supabase-cutover.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "@xyflow/react": "^12.11.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.17.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "pg-query-emscripten": "^5.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
