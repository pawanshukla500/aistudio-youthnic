# Supabase Data API. The publishable key is intentionally browser-safe; never
# put the backend/secret key in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-project-key

# Firebase remains the auth/session and media-storage source of truth.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-app-id
VITE_FIREBASE_MEASUREMENT_ID=replace-with-measurement-id

# Backend-only Firebase administration/storage configuration.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT=replace-with-json-or-base64-service-account
FIREBASE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CATALOG_WORKER_SECRET=replace-with-a-long-random-worker-secret

# Provider keys are backend-only. Install them as Supabase Edge Function secrets;
# never expose them through VITE_* variables or commit real values.
OPENAI_API_KEY=replace-with-openai-key
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_QA_MODEL=gemini-3.6-flash

# Optional Supabase Edge Function retry controls.
POSE_QA_MAX_RETRIES=2
PROVIDER_MAX_RETRIES=2
# Supabase Edge Function-only production secrets (never VITE_ variables)
OPENAI_ADMIN_KEY=replace-with-organization-admin-key
OPENAI_PROJECT_ID=optional-project-filter
GEMINI_RESEARCH_MODEL=gemini-3.6-flash
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM=Youthnic AI Studio <reports@example.com>
